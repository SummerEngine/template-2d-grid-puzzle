; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GridKit"
config/description="Grid-based topdown template. Low-poly primitives, no 2D art. Real-time or turn-based. Arduino-ready."
run/main_scene="res://screens/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputRouter="*res://scripts/input_router.gd"
UITheme="*res://scripts/autoload/ui_theme.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
LevelManager="*res://scripts/autoload/level_manager.gd"
Fader="*res://scripts/autoload/fader.gd"
GameFlow="*res://scripts/autoload/game_flow.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=720

[dotnet]

project/assembly_name="GridKit"

