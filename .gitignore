# Godot 4 import + editor cache
.godot/
# Exported builds
/build/
# *.import files are import settings + uids for the shipped PNG/GLB/SVG assets; commit them
# once an editor pass has generated them so every clone imports identically.
# Editor backups
*.bak
# Summer Engine machine-local state (project id + absolute path)
.summer/local/
# Stray generated assets (not part of the template)
/assets/
